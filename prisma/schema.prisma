generator client {
  provider      = "prisma-client-js"
  binaryTargets = "native"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  password         String
  termsAccepted    Boolean       @default(false)
  isEmailConfirmed Boolean       @default(false)
  tattooArtist     TattooArtist? @relation(fields: [tattooArtistId], references: [id], onDelete: Cascade)
  tattooArtistId   String?       @unique
  profile          Profile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Profile {
  id                   String                @id @default(uuid())
  name                 String
  username             String
  birthDate            String
  imageProfileUrl      String?
  user                 User?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tags                 Tag[]
  historyConversations HistoryConversation[]
  messages             Message[]
  conversations        Conversation[]
  conversationsBlocked Conversation[]        @relation("BlockedBy")
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  profiles  Profile[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TattooArtist {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  address   Address? @relation(fields: [addressId], references: [id], onDelete: Cascade)
  addressId String?  @unique
  user      User?
}

model Address {
  id           String        @id @default(uuid())
  street       String
  number       String
  city         String
  state        String
  country      String        @default("Brazil")
  latitude     Float?
  longitude    Float?
  zipCode      String
  tattooArtist TattooArtist?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// um perfil tem muitos historicos
// um historico tem um perfil
// um historico tem muitas mensagens
// um mensagem tem muitos historicos
// uma conversa tem muitos historicos
// um historico tem uma conversa
// uma conversa tem muitos perfis
// um perfil tem muitas conversas

model Conversation {
  id                   String                @id @default(uuid())
  participants         Profile[]
  blockedBy            Profile[]             @relation("BlockedBy")
  historysConversation HistoryConversation[]
}

model HistoryConversation {
  id             String       @id @default(uuid())
  viewed         Boolean      @default(false)
  messages       Message[]
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  profile        Profile      @relation(fields: [profileId], references: [id])
  profileId      String

  @@index([profileId, conversationId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  from      Profile  @relation(fields: [fromId], references: [id])
  fromId    String
  createdAt DateTime @default(now())

  historyConversations HistoryConversation[]
}
